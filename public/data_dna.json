{
  "project": "ANORENT_ADMIN_DASHBOARD",
  "modules": {
    "inquiriesKanban": {
      "cardDataShape": {
        "id": "string",
        "name": "string",
        "clientName": "string",
        "email": "string",
        "company": "string",
        "budgetRange": "string",
        "budget": "string",
        "timeline": "string",
        "serviceType": "string",
        "servicesNeeded": "string[]",
        "projectSummary": "string",
        "message": "string",
        "status": "string",
        "receivedAt": "string",
        "createdAt": "string",
        "priority": "string",
        "read": "boolean",
        "flagged": "boolean",
        "tags": "string[]",
        "assignedArchitect": "string",
        "internalNotes": "Array<{ id: string, author: string, text: string, createdAt: string }>"
      },
      "statusColumns": [
        "NEW",
        "QUALIFYING",
        "PROPOSAL_SENT",
        "IN_NEGOTIATION",
        "WON",
        "LOST"
      ],
      "editableFields": [
        {
          "name": "status",
          "type": "string",
          "controlType": "select",
          "options": ["NEW", "QUALIFYING", "PROPOSAL_SENT", "IN_NEGOTIATION", "WON", "LOST"]
        },
        {
          "name": "priority",
          "type": "string",
          "controlType": "select",
          "options": ["LOW", "NORMAL", "HIGH", "CRITICAL"]
        },
        {
          "name": "assignedArchitect",
          "type": "string",
          "controlType": "input",
          "options": []
        },
        {
          "name": "budgetRange",
          "type": "string",
          "controlType": "select",
          "options": ["<$5,000", "$5,000 - $15,000", "$15,000 - $30,000", "$30,000 - $60,000", "$60,000+"]
        },
        {
          "name": "servicesNeeded",
          "type": "string[]",
          "controlType": "input",
          "options": []
        },
        {
          "name": "projectSummary",
          "type": "string",
          "controlType": "textarea",
          "options": []
        },
        {
          "name": "flagged",
          "type": "boolean",
          "controlType": "toggle",
          "options": []
        },
        {
          "name": "read",
          "type": "boolean",
          "controlType": "toggle",
          "options": []
        }
      ],
      "internalNotesShape": {
        "id": "string",
        "author": "string",
        "text": "string",
        "createdAt": "string"
      }
    },
    "deploymentsManager": {
      "tableColumns": [
        "Preview",
        "Title & Slug",
        "Category & Badge",
        "Stats & Rating",
        "Tech Stack",
        "Featured",
        "Status",
        "Actions"
      ],
      "editorFormInputs": [
        { "name": "title", "dataType": "string", "controlType": "text", "required": true, "defaultValue": "" },
        { "name": "idSlug", "dataType": "string", "controlType": "text", "required": true, "defaultValue": "" },
        { "name": "category", "dataType": "string", "controlType": "select", "required": true, "defaultValue": "SAAS DASHBOARDS" },
        { "name": "badge", "dataType": "string", "controlType": "select", "required": false, "defaultValue": "FEATURED" },
        { "name": "isFeatured", "dataType": "boolean", "controlType": "toggle", "required": true, "defaultValue": true },
        { "name": "shortDescription", "dataType": "string", "controlType": "textarea", "required": true, "defaultValue": "" },
        { "name": "fullDescription", "dataType": "string", "controlType": "textarea", "required": false, "defaultValue": "" },
        { "name": "thumbnailUrl", "dataType": "string", "controlType": "text", "required": true, "defaultValue": "" },
        { "name": "coverImageUrl", "dataType": "string", "controlType": "text", "required": false, "defaultValue": "" },
        { "name": "demoUrl", "dataType": "string", "controlType": "text", "required": false, "defaultValue": "" },
        { "name": "githubUrl", "dataType": "string", "controlType": "text", "required": false, "defaultValue": "" },
        { "name": "liveUrl", "dataType": "string", "controlType": "text", "required": false, "defaultValue": "" },
        { "name": "rating", "dataType": "number", "controlType": "number", "required": false, "defaultValue": 4.9 },
        { "name": "usersCount", "dataType": "string", "controlType": "text", "required": false, "defaultValue": "10k+" },
        { "name": "viewsCount", "dataType": "string", "controlType": "text", "required": false, "defaultValue": "50k" },
        { "name": "tags", "dataType": "string[]", "controlType": "tag-list", "required": false, "defaultValue": ["React", "Tailwind"] },
        { "name": "techStack", "dataType": "string[]", "controlType": "tag-list", "required": true, "defaultValue": ["Next.js 15", "TypeScript"] },
        { "name": "features", "dataType": "string[]", "controlType": "tag-list", "required": false, "defaultValue": [] },
        { "name": "technicalMetrics", "dataType": "string[]", "controlType": "tag-list", "required": false, "defaultValue": [] },
        { "name": "status", "dataType": "string", "controlType": "select", "required": true, "defaultValue": "Production" },
        { "name": "isPublished", "dataType": "boolean", "controlType": "toggle", "required": true, "defaultValue": true }
      ],
      "categoryOptions": [
        "SAAS DASHBOARDS",
        "UI TEMPLATES",
        "FULL-STACK APPS",
        "ANIMATED SITES"
      ],
      "statusOptions": [
        "Production",
        "Staging",
        "Archived"
      ]
    },
    "heroCmsEditor": {
      "formInputs": [
        { "name": "badgeText", "dataType": "string", "controlType": "text" },
        { "name": "mainHeading", "dataType": "string", "controlType": "text" },
        { "name": "highlightedWord", "dataType": "string", "controlType": "text" },
        { "name": "subheading", "dataType": "string", "controlType": "textarea" },
        { "name": "primaryCtaText", "dataType": "string", "controlType": "text" },
        { "name": "primaryCtaUrl", "dataType": "string", "controlType": "text" },
        { "name": "secondaryCtaText", "dataType": "string", "controlType": "text" },
        { "name": "secondaryCtaUrl", "dataType": "string", "controlType": "text" }
      ]
    },
    "storyStagesCmsEditor": {
      "stageFields": [
        { "name": "id", "dataType": "string" },
        { "name": "phase", "dataType": "string" },
        { "name": "year", "dataType": "string" },
        { "name": "title", "dataType": "string" },
        { "name": "subtitle", "dataType": "string" },
        { "name": "description", "dataType": "string" },
        { "name": "highlightTag", "dataType": "string" },
        { "name": "thumbnail", "dataType": "string" },
        { "name": "tags", "dataType": "string[]" },
        { "name": "displayOrder", "dataType": "number" }
      ],
      "nestedArchitectureNodeFields": [
        { "name": "nodeId", "dataType": "string" },
        { "name": "label", "dataType": "string" },
        { "name": "role", "dataType": "string" }
      ],
      "nestedEscrowPhaseFields": [
        { "name": "phaseId", "dataType": "string" },
        { "name": "milestone", "dataType": "string" },
        { "name": "percentage", "dataType": "number" }
      ]
    },
    "aboutAndProofCmsEditor": {
      "profileFields": [
        { "name": "artistName", "dataType": "string" },
        { "name": "role", "dataType": "string" },
        { "name": "tagline", "dataType": "string" },
        { "name": "handle", "dataType": "string" },
        { "name": "executiveBio", "dataType": "string" },
        { "name": "avatarUrl", "dataType": "string" },
        { "name": "location", "dataType": "string" },
        { "name": "availability", "dataType": "string" },
        { "name": "techSkills", "dataType": "string[]" }
      ],
      "proofCardFields": [
        { "name": "id", "dataType": "string" },
        { "name": "label", "dataType": "string" },
        { "name": "value", "dataType": "string" },
        { "name": "subtext", "dataType": "string" },
        { "name": "percentage", "dataType": "number" }
      ]
    },
    "faqCmsEditor": {
      "headerFields": [
        { "name": "headline", "dataType": "string" },
        { "name": "subtitle", "dataType": "string" }
      ],
      "itemFields": [
        { "name": "id", "dataType": "string" },
        { "name": "question", "dataType": "string" },
        { "name": "answer", "dataType": "string" }
      ]
    },
    "reviewsModerator": {
      "itemDataShape": {
        "id": "string",
        "author": "string",
        "company": "string",
        "avatar": "string",
        "quote": "string",
        "rating": "number",
        "isApproved": "boolean",
        "isFeatured": "boolean"
      },
      "toggleActions": [
        { "actionName": "toggleApproval", "targetField": "isApproved" },
        { "actionName": "toggleFeatured", "targetField": "isFeatured" }
      ]
    },
    "telemetryAndGlobalSettings": {
      "formInputs": [
        { "name": "directEmail", "dataType": "string" },
        { "name": "headline", "dataType": "string" },
        { "name": "subtitle", "dataType": "string" },
        { "name": "dribbble", "dataType": "string" },
        { "name": "github", "dataType": "string" },
        { "name": "discord", "dataType": "string" },
        { "name": "twitter", "dataType": "string" },
        { "name": "linkedin", "dataType": "string" },
        { "name": "telegram", "dataType": "string" },
        { "name": "tagline", "dataType": "string" },
        { "name": "copyright", "dataType": "string" }
      ]
    }
  },
  "serverActionMutations": [
    {
      "actionName": "updateInquiryStatus",
      "targetTable": "inquiries",
      "payloadShape": { "id": "string", "status": "string" },
      "revalidatePaths": ["/admin/inquiries"]
    },
    {
      "actionName": "saveDeployment",
      "targetTable": "deployments",
      "payloadShape": { "id": "string", "title": "string", "category": "string", "status": "string" },
      "revalidatePaths": ["/admin/deployments", "/portfolio"]
    },
    {
      "actionName": "updateCmsContent",
      "targetTable": "cms_settings",
      "payloadShape": { "sectionKey": "string", "contentJson": "object" },
      "revalidatePaths": ["/"]
    }
  ]
}
