{
  "project": "ANORENT_ADMIN_DASHBOARD",
  "inquiriesKanban": {
    "statusLanes": ["NEW", "QUALIFYING", "PROPOSAL_SENT", "IN_NEGOTIATION", "WON", "LOST"],
    "cardFields": {
      "id": "string | read-only-id | required",
      "clientName": "string | text-input | required",
      "email": "string | email-input | required",
      "company": "string? | text-input | optional",
      "budgetTier": "string | select | required | ['<$5,000', '$5,000 - $15,000', '$15,000 - $30,000', '$30,000 - $60,000', '$60,000+']",
      "timeline": "string? | text-input | optional",
      "serviceType": "string? | select | optional",
      "servicesNeeded": "string[] | tag-input | optional",
      "projectBrief": "string | textarea | required",
      "status": "string | lane-select | default: NEW | ['NEW', 'QUALIFYING', 'PROPOSAL_SENT', 'IN_NEGOTIATION', 'WON', 'LOST']",
      "priority": "string | select | default: NORMAL | ['LOW', 'NORMAL', 'HIGH', 'CRITICAL']",
      "read": "boolean | toggle | default: false",
      "flagged": "boolean | toggle | default: false",
      "tags": "string[] | tag-input | optional",
      "assignedArchitect": "string? | select | optional",
      "internalNotes": "Record<string, any>[] | json-list | optional"
    }
  },
  "deploymentsManager": {
    "tableColumns": ["Preview", "Title & Slug", "Category", "Rating & Stats", "Tech Stack", "Featured", "Status", "Actions"],
    "formFields": {
      "id": "string | auto-id | auto-generated",
      "title": "string | text-input | required",
      "slug": "string | text-input | required | auto-from-title",
      "category": "string | select | required | ['SAAS DASHBOARDS', 'UI TEMPLATES', 'FULL-STACK APPS', 'ANIMATED SITES', 'WEB3 & CRYPTO', 'AI PLATFORMS']",
      "badge": "string? | text-input | default: 'FEATURED'",
      "shortDescription": "string | textarea | required",
      "fullDescription": "string? | textarea | optional",
      "thumbnailUrl": "string | image-url | required",
      "coverImageUrl": "string? | image-url | optional",
      "demoUrl": "string? | link-url | optional",
      "githubUrl": "string? | link-url | optional",
      "liveUrl": "string? | link-url | optional",
      "rating": "number | number-stepper | default: 4.9",
      "usersCount": "string | text-input | default: '10k+'",
      "viewsCount": "string | text-input | default: '50k'",
      "tags": "string[] | tag-input | optional",
      "techStack": "string[] | tag-input | required",
      "features": "string[] | tag-input | optional",
      "technicalMetrics": "Record<string, string>[] | key-value-list | optional",
      "status": "string | select | default: Production | ['Production', 'Staging', 'Archived']",
      "displayOrder": "number | number-input | default: 1",
      "isFeatured": "boolean | toggle | default: true",
      "isPublished": "boolean | toggle | default: true"
    }
  },
  "heroCmsEditor": {
    "formFields": {
      "badgeText": "string | text-input | required | default: 'Next-Gen Web Architecture'",
      "mainHeading": "string | text-input | required",
      "highlightedWord": "string | text-input | required",
      "subheading": "string | textarea | required",
      "primaryCtaText": "string | text-input | required | default: 'EXPLORE DEPLOYMENTS'",
      "primaryCtaUrl": "string | text-input | required | default: '#deployments'",
      "secondaryCtaText": "string | text-input | required | default: 'INITIALIZE CONTACT'",
      "secondaryCtaUrl": "string | text-input | required | default: '#contact'"
    }
  },
  "storyStagesCmsEditor": {
    "stageFields": {
      "stageIndex": "number | number-stepper | required | unique",
      "phase": "string | text-input | required",
      "year": "string | text-input | required",
      "title": "string | text-input | required",
      "subtitle": "string | text-input | required",
      "description": "string | textarea | required",
      "highlightTag": "string | text-input | required",
      "tags": "string[] | tag-input | required",
      "displayOrder": "number | number-input | default: 1"
    },
    "nestedArchitectureNodes": {
      "id": "string | auto-id | required",
      "label": "string | text-input | required",
      "role": "string | text-input | required",
      "status": "string | select | default: active | ['active', 'idle', 'syncing']",
      "icon": "string? | text-input | optional",
      "description": "string? | textarea | optional",
      "techSpecs": "string[] | tag-input | optional",
      "benchmarkMetric": "string? | text-input | optional"
    },
    "nestedEscrowPhases": {
      "phaseNumber": "number | number-input | required",
      "title": "string | text-input | required",
      "description": "string | textarea | required",
      "verificationCriteria": "string? | textarea | optional",
      "status": "string | select | default: PENDING | ['COMPLETED', 'IN_PROGRESS', 'PENDING']",
      "allocationPercentage": "number | number-input | default: 25"
    }
  },
  "aboutAndProofCmsEditor": {
    "aboutFields": {
      "artistName": "string | text-input | required",
      "role": "string | text-input | required",
      "tagline": "string | text-input | required",
      "handle": "string | text-input | required",
      "executiveBio": "string | textarea | required",
      "avatarUrl": "string | image-url | required",
      "location": "string | text-input | required",
      "availability": "string | text-input | required",
      "techSkills": "string[] | tag-input | required"
    },
    "proofCardFields": {
      "id": "string | auto-id | required",
      "title": "string | text-input | required",
      "value": "string | text-input | required",
      "subtext": "string | textarea | required",
      "percentage": "number | slider | default: 100",
      "displayOrder": "number | number-input | default: 1"
    }
  },
  "faqCmsEditor": {
    "headerFields": {
      "headline": "string | text-input | required",
      "subtitle": "string | textarea | required",
      "supportEmail": "string | email-input | required"
    },
    "itemFields": {
      "id": "string | auto-id | required",
      "question": "string | text-input | required",
      "answer": "string | textarea | required",
      "category": "string | select | required | ['General', 'Architecture', 'Development', 'Pricing & Escrow', 'Support']",
      "displayOrder": "number | number-input | default: 1",
      "isPublished": "boolean | toggle | default: true"
    }
  },
  "reviewsModerator": {
    "itemFields": {
      "id": "string | read-only-id | required",
      "author": "string | text | read-only",
      "company": "string? | text | read-only",
      "avatar": "string? | image-url | read-only",
      "quote": "string | textarea | read-only",
      "rating": "number | stars | read-only",
      "isApproved": "boolean | toggle | default: false",
      "isFeatured": "boolean | toggle | default: false",
      "createdAt": "string | date-time | read-only"
    }
  },
  "siteConfigCms": {
    "headerFields": {
      "brandName": "string | text-input | default: 'ANORENT'",
      "studioTitle": "string | text-input | default: 'ANORENT STUDIO'",
      "isOnline": "boolean | toggle | default: true",
      "primaryColorHex": "string | color-picker | default: '#a855f7'"
    },
    "footerFields": {
      "directEmail": "string | email-input | required",
      "tagline": "string | text-input | required",
      "copyright": "string | text-input | required",
      "socialLinks": "Record<string, string> | url-map | optional"
    }
  }
}
