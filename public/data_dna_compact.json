{
  "project": "ANORENT_ADMIN_DASHBOARD",
  "modules": {
    "inquiriesKanban": {
      "statusColumns": ["NEW", "QUALIFYING", "PROPOSAL_SENT", "IN_NEGOTIATION", "WON", "LOST"],
      "cardFields": {
        "id": "string | id | required | read-only",
        "name": "string | text | required",
        "clientName": "string | text | required",
        "email": "string | email | required",
        "company": "string? | text | optional",
        "budgetRange": "string | select | required | ['<$5,000', '$5,000 - $15,000', '$15,000 - $30,000', '$30,000 - $60,000', '$60,000+']",
        "timeline": "string? | text | optional",
        "serviceType": "string? | text | optional",
        "servicesNeeded": "string[] | tag-input | optional",
        "projectSummary": "string | textarea | required",
        "message": "string? | textarea | optional",
        "status": "string | select | default: NEW | ['NEW', 'QUALIFYING', 'PROPOSAL_SENT', 'IN_NEGOTIATION', 'WON', 'LOST']",
        "receivedAt": "string | date-time | read-only",
        "priority": "string | select | default: NORMAL | ['LOW', 'NORMAL', 'HIGH', 'CRITICAL']",
        "read": "boolean | toggle | default: false",
        "flagged": "boolean | toggle | default: false",
        "tags": "string[] | tag-input | optional",
        "assignedArchitect": "string? | text | optional",
        "internalNotes": "json[] | nested-array | optional"
      }
    },
    "deploymentsManager": {
      "tableColumns": ["Preview", "Title & Slug", "Category & Badge", "Stats & Rating", "Tech Stack", "Featured", "Status", "Actions"],
      "formFields": {
        "id": "string | id | auto-generated",
        "title": "string | text | required",
        "slug": "string | text | required | auto-generated-from-title",
        "category": "string | select | required | ['SAAS DASHBOARDS', 'UI TEMPLATES', 'FULL-STACK APPS', 'ANIMATED SITES']",
        "badge": "string? | text | optional | default: FEATURED",
        "badgeLabel": "string? | text | optional",
        "isFeatured": "boolean | toggle | default: true",
        "shortDescription": "string | textarea | required",
        "fullDescription": "string? | textarea | optional",
        "thumbnailUrl": "string | url | required",
        "coverImageUrl": "string? | url | optional",
        "demoUrl": "string? | url | optional",
        "githubUrl": "string? | url | optional",
        "liveUrl": "string? | url | optional",
        "rating": "number | number-input | default: 4.9",
        "usersCount": "string | text | default: 10k+",
        "viewsCount": "string | text | default: 50k",
        "tags": "string[] | tag-input | optional",
        "techStack": "string[] | tag-input | required",
        "features": "string[] | tag-input | optional",
        "technicalMetrics": "json[] | key-value-list | optional",
        "status": "string | select | default: Production | ['Production', 'Staging', 'Archived']",
        "displayOrder": "number | number-input | default: 1",
        "isPublished": "boolean | toggle | default: true"
      }
    },
    "heroCmsEditor": {
      "formFields": {
        "badgeText": "string | text | required | default: Next-Gen Web Architecture",
        "mainHeading": "string | text | required",
        "highlightedWord": "string | text | required",
        "subheading": "string | textarea | required",
        "primaryCtaText": "string | text | required | default: EXPLORE DEPLOYMENTS",
        "primaryCtaUrl": "string | text | required | default: #deployments",
        "secondaryCtaText": "string | text | required | default: INITIALIZE CONTACT",
        "secondaryCtaUrl": "string | text | required | default: #contact"
      }
    },
    "storyStagesCmsEditor": {
      "stageFields": {
        "id": "string | id | required",
        "phase": "string | text | required",
        "year": "string | text | required",
        "title": "string | text | required",
        "subtitle": "string | text | required",
        "description": "string | textarea | required",
        "highlightTag": "string | text | required",
        "thumbnail": "string | url | required",
        "tags": "string[] | tag-input | required",
        "displayOrder": "number | number-input | default: 1"
      },
      "nestedArchitectureNodes": {
        "id": "string | id | required",
        "label": "string | text | required",
        "role": "string | text | required",
        "status": "string | select | default: active | ['active', 'idle', 'syncing']",
        "icon": "string | text | optional"
      },
      "nestedEscrowPhases": {
        "phaseNumber": "number | number-input | required",
        "title": "string | text | required",
        "description": "string | textarea | required",
        "status": "string | select | default: PENDING | ['COMPLETED', 'IN_PROGRESS', 'PENDING']",
        "allocationPercentage": "number | number-input | default: 25"
      }
    },
    "aboutAndProofCmsEditor": {
      "aboutFields": {
        "artistName": "string | text | required",
        "role": "string | text | required",
        "tagline": "string | text | required",
        "handle": "string | text | required",
        "executiveBio": "string | textarea | required",
        "avatarUrl": "string | url | required",
        "location": "string | text | required",
        "availability": "string | text | required",
        "techSkills": "string[] | tag-input | required"
      },
      "proofMetricCardFields": {
        "id": "string | id | required",
        "label": "string | text | required",
        "value": "string | text | required",
        "subtext": "string | textarea | required",
        "percentage": "number | number-input | default: 100",
        "displayOrder": "number | number-input | default: 1"
      }
    },
    "faqCmsEditor": {
      "headerFields": {
        "headline": "string | text | required",
        "subtitle": "string | textarea | required"
      },
      "itemFields": {
        "id": "string | id | required",
        "question": "string | text | required",
        "answer": "string | textarea | required",
        "category": "string | select | required | ['General', 'Architecture', 'Escrow', 'Pricing']",
        "displayOrder": "number | number-input | default: 1",
        "isPublished": "boolean | toggle | default: true"
      }
    },
    "reviewsModerator": {
      "itemFields": {
        "id": "string | id | read-only",
        "author": "string | text | read-only",
        "company": "string | text | read-only",
        "avatar": "string? | url | read-only",
        "quote": "string | textarea | read-only",
        "rating": "number | rating-stars | read-only",
        "isApproved": "boolean | toggle | default: false",
        "isFeatured": "boolean | toggle | default: false",
        "createdAt": "string | date-time | read-only"
      }
    },
    "siteConfigAndTelemetry": {
      "headerFields": {
        "brandName": "string | text | default: ANORENT",
        "studioTitle": "string | text | default: Lumaora / Anorent",
        "isOnline": "boolean | toggle | default: true",
        "primaryColorHex": "string | text | default: #a855f7"
      },
      "footerFields": {
        "directEmail": "string | email | required",
        "headline": "string | text | required",
        "subtitle": "string | textarea | required",
        "socialDribbble": "string? | url | optional",
        "socialGithub": "string? | url | optional",
        "socialDiscord": "string? | url | optional",
        "socialTwitter": "string? | url | optional",
        "socialLinkedin": "string? | url | optional",
        "socialTelegram": "string? | url | optional",
        "tagline": "string | text | required",
        "copyright": "string | text | required"
      }
    }
  },
  "mutations": {
    "upsertDeployment": { "target": "deployments", "revalidate": ["/admin/deployments", "/"] },
    "updateHeroCms": { "target": "cms_hero", "revalidate": ["/"] },
    "updateStoryStages": { "target": "cms_story_stages", "revalidate": ["/"] },
    "updateAboutAndProof": { "target": "cms_about_proof", "revalidate": ["/"] },
    "upsertFaq": { "target": "cms_faq", "revalidate": ["/"] },
    "toggleReviewApproval": { "target": "reviews", "revalidate": ["/admin/reviews", "/"] },
    "updateInquiryStatus": { "target": "inquiries", "revalidate": ["/admin/inquiries"] },
    "updateSiteConfig": { "target": "cms_settings", "revalidate": ["/"] }
  }
}
