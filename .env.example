# =============================================================================
# ANORIX STUDIO ADMIN DASHBOARD — Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env or .env.local to git.

# -----------------------------------------------------------------------------
# 1. DATABASE (Neon PostgreSQL — https://neon.tech)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@your-neon-host.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@your-neon-host.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# 2. NEXTAUTH & SECURITY
# -----------------------------------------------------------------------------
# Generate a secure 32-character secret: openssl rand -base64 32
AUTH_SECRET="your_32_character_random_auth_secret_here"
AUTH_TRUST_HOST=true
# Set to your production domain on Vercel (e.g., https://anorix-dashboard.vercel.app)
NEXTAUTH_URL="https://anorix-dashboard.vercel.app"
NEXT_PUBLIC_APP_URL="https://anorix-dashboard.vercel.app"

# -----------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (https://console.cloud.google.com/apis/credentials)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# -----------------------------------------------------------------------------
# 4. SUPERADMIN AUTHORIZED WHITELIST EMAIL
# -----------------------------------------------------------------------------
ADMIN_EMAIL="muhammadahsanjaved09@gmail.com"

# -----------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (https://aistudio.google.com/app/apikey)
# -----------------------------------------------------------------------------
# Required for Chief Analytics Copilot & Autonomous Project Provisioning
GEMINI_API_KEY="your_google_ai_studio_gemini_api_key_here"

# -----------------------------------------------------------------------------
# 6. UPLOADTHING CDN (https://uploadthing.com/dashboard)
# -----------------------------------------------------------------------------
# Required for permanent thumbnail, showcase cover, and avatar CDN image hosting
UPLOADTHING_TOKEN="your_uploadthing_token_here"
