// Prisma schema for ANORENT Studio
// Optimized for Neon Serverless PostgreSQL & Next.js App Router

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --------------------------------------------------------
// 1. SITE CONFIG & GLOBAL BRAND TELEMETRY
// --------------------------------------------------------
model SiteConfig {
  id              String   @id @default(cuid())
  brandName       String   @default("ANORENT")
  brandLogoText   String   @default("ANORENT")
  brandTagline    String   @default("Digital Artist & Creative Technologist Studio")
  liveBadgeStatus String   @default("99.98% LIVE")
  pingLatency     String   @default("24ms")
  escrowCoverage  String   @default("100% ESCROW-PROTECTED")
  contactEmail    String   @default("hello@anorent.com")
  telegramHandle  String?  @default("@anorent")
  discordHandle   String?  @default("anorent#0001")
  githubUrl       String?  @default("https://github.com/anorent")
  twitterUrl      String?  @default("https://twitter.com/anorent")
  socialChannels  Json?
  metaTitle       String?  @default("ANORENT — Cybernetic Web Experiences & 3D Architect")
  metaDescription String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --------------------------------------------------------
// 2. USER & ADMIN AUTHENTICATION
// --------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         String   @default("ADMIN") // ADMIN, EDITOR, VIEWER
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --------------------------------------------------------
// 3. DEPLOYMENT PRODUCTS / PORTFOLIO PROJECTS
// --------------------------------------------------------
model DeploymentProduct {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  client           String?
  year             String?
  category         String
  badge            String?
  shortDescription String
  fullDescription  String?  @db.Text
  thumbnailUrl     String
  coverImageUrl    String?
  previewVideoUrl  String?
  demoUrl          String
  githubUrl        String?
  liveUrl          String?
  rating           Float?   @default(5.0)
  usersCount       String?
  viewsCount       String?
  tags             String[] @default([])
  techStack        String[] @default([])
  features         String[] @default([])
  fpsBenchmark     Int?     @default(60)
  auditScore       Int?     @default(100)
  status           String   @default("Production")
  isFeatured       Boolean  @default(false)
  isPublished      Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([isFeatured])
  @@index([isPublished])
}

// --------------------------------------------------------
// 4. CLIENT REVIEWS & TESTIMONIALS
// --------------------------------------------------------
model ReviewItem {
  id         String   @id @default(cuid())
  name       String
  role       String?
  company    String?
  avatarUrl  String?
  comment    String   @db.Text
  rating     Int      @default(5)
  dateString String?
  tags       String[] @default([])
  isVerified Boolean  @default(true)
  isApproved Boolean  @default(true)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isApproved])
  @@index([isFeatured])
}

// --------------------------------------------------------
// 5. CONTACT SUBMISSIONS & KANBAN INQUIRIES
// --------------------------------------------------------
model ContactSubmission {
  id            String   @id @default(cuid())
  name          String
  email         String
  company       String?
  projectType   String?
  budget        String?
  timeline      String?
  message       String   @db.Text
  status        String   @default("NEW") // NEW, QUALIFYING, PROPOSAL_SENT, IN_NEGOTIATION, WON, LOST, UNREAD, IN_REVIEW, CONTACTED, CLOSED
  priority      String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  notes         String?  @db.Text
  internalNotes String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([priority])
}

// --------------------------------------------------------
// 6. FREQUENTLY ASKED QUESTIONS (FAQ) & FAQ CONFIG
// --------------------------------------------------------
model FaqHeaderConfig {
  id                String   @id @default(cuid())
  badgeText         String   @default("[ CLEAR ANSWERS // ZERO AMBIGUITY ]")
  pageTitle         String   @default("FREQUENTLY ASKED QUESTIONS")
  pageSubtitle      String   @default("Straight talk on pricing, escrow milestones, WebGL performance, and production handoff.")
  searchPlaceholder String   @default("Search escrow, stack, timelines, pricing...")
  supportEmail      String   @default("hello@anorent.com")
  telemetry1Title   String   @default("ESCROW PROTECTED")
  telemetry1Sub     String   @default("100% Milestone-gated")
  telemetry2Title   String   @default("PERFORMANCE SLA")
  telemetry2Sub     String   @default("60 FPS WebGL Target")
  telemetry3Title   String   @default("IP TRANSFERRED")
  telemetry3Sub     String   @default("Full Commercial License")
  telemetry4Title   String   @default("RESPONSE TIME")
  telemetry4Sub     String   @default("< 4h Direct Comm")
  categories        String[] @default(["ALL", "PRICING & ESCROW", "TECH & SHADERS", "DELIVERY TIMELINE", "SUPPORT & SLA"])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FAQItem {
  id           String   @id @default(cuid())
  category     String
  question     String
  answer       String   @db.Text
  helpfulCount Int      @default(0)
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
}

// --------------------------------------------------------
// 7. PROOF METRIC CARDS & TELEMETRY
// --------------------------------------------------------
model ProofMetricCard {
  id           String   @id @default(cuid())
  cardKey      String   @unique
  title        String
  value        String
  subtext      String?
  percentage   Float?
  slaTarget    String?
  displayOrder Int      @default(0)
  metricsJson  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --------------------------------------------------------
// 8. HERO SECTION CONTENT & TELEMETRY
// --------------------------------------------------------
model HeroContent {
  id                  String   @id @default(cuid())
  badgeText           String   @default("[ SOLO CREATIVE DEVELOPER & 3D ARTIST ]")
  superTitle          String?
  headlineLine1       String   @default("CYBERNETiC CRAFT")
  headlineLine2       String   @default("DiGiTAL REALMS")
  headlineLine3       String   @default("ENGiNEERED.")
  mainHeading         String?
  mainTitle           String?
  highlightedWord     String?  @default("CRAFT")
  bioSubtext          String   @db.Text
  subheading          String?
  subtitle            String?
  highlightWords      String[] @default([])
  primaryCtaLabel     String   @default("START A PROJECT ↗")
  primaryCtaText      String?
  primaryCtaRoute     String   @default("contact")
  primaryCtaUrl       String?
  secondaryCtaLabel   String   @default("BROWSE DEPLOYMENTS")
  secondaryCtaText    String?
  secondaryCtaRoute   String   @default("deployments")
  secondaryCtaUrl     String?
  telemetryStatus     String   @default("ONLINE")
  telemetryLatency    String   @default("4ms")
  telemetryUptime     String   @default("99.98%")
  pricingNoticeText   String   @default("Custom builds starting at $1,000 // Fast turnaround")
  particleModes       String[] @default(["quantum", "orbital", "matrix"])
  defaultParticleMode String   @default("quantum")
  baseNodeCount       Int      @default(100)
  targetFps           Int      @default(60)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// --------------------------------------------------------
// 9. HORIZONTAL STORY STAGES & ARCHITECTURE NODES
// --------------------------------------------------------
model StoryStage {
  id            String             @id @default(cuid())
  stageIndex    Int                @unique
  phase         String?
  year          String?
  title         String?
  subtitle      String?
  description   String             @db.Text
  highlightTag  String?
  stageBadge    String?
  headlineLine1 String?
  headlineLine2 String?
  specTag1Title String?
  specTag1Sub   String?
  specTag2Title String?
  specTag2Sub   String?
  specTag3Title String?
  specTag3Sub   String?
  bulletPoint1  String?
  bulletPoint2  String?
  nodes         ArchitectureNode[]
  phases        EscrowPhase[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model ArchitectureNode {
  id        String      @id @default(cuid())
  stageId   String?
  stage     StoryStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)
  key       String
  name      String
  latency   String
  summary   String      @db.Text
  order     Int         @default(0)
  createdAt DateTime    @default(now())
}

model EscrowPhase {
  id                   String      @id @default(cuid())
  stageId              String?
  stage                StoryStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)
  phaseNumber          Int
  title                String
  description          String      @db.Text
  verificationCriteria String?
  status               String      @default("PENDING")
  allocationPercentage Int         @default(25)
  badgeText            String?
  createdAt            DateTime    @default(now())
}

// --------------------------------------------------------
// 10. ABOUT PAGE CONTENT & CREATIVE BIO
// --------------------------------------------------------
model AboutContent {
  id                   String   @id @default(cuid())
  name                 String   @default("ANORENT")
  artistName           String?  @default("Ahsan")
  role                 String   @default("Lead Creative Technologist & Full-Stack Architect")
  tagline              String?  @default("Solo Creative Developer & 3D Artist")
  handle               String?  @default("ahsxn.3d")
  avatarUrl            String?  @default("https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80")
  executiveBio         String   @db.Text
  bio                  String?  @db.Text
  location             String   @default("Global Remote // Earth Grid")
  locationTimezone     String   @default("UTC / EST Active")
  availabilityStatus   String   @default("LIMITED SLOTS AVAILABLE")
  yearsActive          String   @default("7+ Years")
  deploymentsDelivered String   @default("48+")
  clientSatisfaction   String   @default("99.8%")
  techSkills           String[] @default([])
  contactEmail         String   @default("hello@anorent.com")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

